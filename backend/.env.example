# Project Two Lead Hunter – konfigurace backendu (zkopírujte jako .env)

# --- Databáze (výchozí SQLite v backend/data) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/leadhunter
# DATA_DIR=./data

# --- Zabezpečení: pokud nastavíte, API vyžaduje Bearer token (stejný dejte do frontend/.env.local) ---
API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Automatizace ---
SCHEDULER_ENABLED=true
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# --- Crawling (ohleduplnost k cizím webům) ---
PER_DOMAIN_DELAY_SECONDS=2
MAX_PAGES_PER_SITE=5
# PLAYWRIGHT_EXECUTABLE_PATH=/cesta/k/chromium

# --- Zdroje dat ---
# Brave Search API (zdarma ~2000 dotazů/měsíc): https://brave.com/search/api/
BRAVE_API_KEY=
# Google Programmable Search (zdarma 100 dotazů/den)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- AI: auto = Ollama → Anthropic → OpenAI-kompatibilní ---
TEXT_PROVIDER=auto
VISION_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Externí vision API (volitelné)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
